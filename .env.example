SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# any long random string; encrypts stored credentials (AES-256-GCM)
ENCRYPTION_KEY=
# login for the editor (the /login page)
ADMIN_USER=admin
ADMIN_PASSWORD=
# bearer token required by /api/cron
CRON_SECRET=
# optional: signs the login cookie. Falls back to ENCRYPTION_KEY if empty
SESSION_SECRET=

# Telegram needs a public https address. On a laptop, run a tunnel (ngrok or cloudflared) and put its https URL here.
# On Vercel you can leave this empty.
# PUBLIC_URL=https://your-tunnel.ngrok-free.app
